{
  "name": "bawa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts *.js *.json *.html README.md docs/*.md",
    "test:db": "node scripts/test-database.mjs",
    "test:integration": "playwright test -c playwright.integration.config.js",
    "cap:build": "vite build && cap sync android",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@fontsource/geist": "^5.2.0",
    "@fontsource/geist-mono": "^5.2.0",
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.6.0",
    "vite": "^6.4.4"
  }
}
